# Trust Shield SMTP Email Dispatch Configuration Template
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=trustshield.auth@gmail.com
SMTP_PASS=your-16-char-app-password

# Google OAuth 2.0 Client ID (from console.cloud.google.com -> APIs & Services -> Credentials)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

